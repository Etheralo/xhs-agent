# 复制为 .env 后填写。不要提交真实密钥。
# 可连接任何支持 OpenAI chat/completions 接口的模型服务。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=your-model-name
# 以下参数也可覆盖 config/settings.yaml 中的流式与长度设置。
LLM_STREAM=true
LLM_JSON_MODE=true
LLM_DISABLE_THINKING=true
LLM_READ_TIMEOUT_SECONDS=600
LLM_MAX_INPUT_CHARS=55000
LLM_MAX_COMPLETION_TOKENS=4096

# OpenAlex key 免费申请；缺失时会议状态只能依赖人工覆盖配置。
OPENALEX_API_KEY=

# 小红书发布模式：manual（默认）、browser（本机浏览器自动填充）或 webhook。
XHS_PUBLISH_MODE=manual
# browser 模式使用独立 Chrome 登录态；首次配置后运行 uv run xhs-agent xhs-login。
XHS_CREATOR_URL=https://creator.xiaohongshu.com/publish/publish?source=official
# XHS_BROWSER_PROFILE_DIR=/absolute/path/to/xhs-browser-profile
XHS_BROWSER_CHANNEL=chrome
XHS_BROWSER_HEADLESS=false
XHS_PUBLISH_TIMEOUT_SECONDS=180

# webhook 模式：将审核通过的 ZIP 发布包发送给你自己的平台发布连接器。
# 连接器接收 multipart/form-data：metadata(JSON) + package(ZIP)。
XHS_PUBLISH_WEBHOOK_URL=
WECHAT_PUBLISH_WEBHOOK_URL=
PUBLISH_WEBHOOK_TOKEN=

# 可选：把运行数据放到其他目录。
# XHS_AGENT_DATA_DIR=/absolute/path/to/data
# XHS_AGENT_OUTPUT_DIR=/absolute/path/to/output
